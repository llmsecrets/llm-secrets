# scrt4 module manifest
#
# This repository ships the crypto core and the per-OS clients. It does not
# ship modules, so the only distribution defined here is [core-only].
#
# The manifest is still required: scripts/build-scrt4.sh reads it to find the
# [DISTRIBUTION] section, and exits if the file is absent.
#
#   scripts/build-scrt4.sh core-only ./scrt4
#
# A section with no entries produces the core dispatcher with no modules
# appended, which is the intended build.

[core-only]
# No modules. The smallest possible build: the TCB and nothing else.
